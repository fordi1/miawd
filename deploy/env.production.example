# Copy to .env.production on the server. Never commit the real file.
# Generate each secret with:  openssl rand -hex 32
DB_PASSWORD=
API_KEY_PEPPER=
SLOT_TOKEN_SECRET=

# A domain name that points to this server (Caddy gets a free HTTPS certificate for it), or :80 for plain http for now.
SITE_ADDRESS=:80
# The address people use, shown in the API docs, e.g. https://api.example.com  (leave empty until there is one)
PUBLIC_URL=
# true once the site is served over https (marks the panel cookies Secure)
COOKIE_SECURE=false

# Only change these if ports 80/443 are already used on the server
HTTP_PORT=80
HTTPS_PORT=443
