{
  "name": "mawid-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "dev": "tsx --env-file=.env src/server.ts",
    "create-admin": "tsx --env-file=.env src/db/createAdmin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.7",
    "luxon": "^3.7.2",
    "marked": "^18.1.2",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
