# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://mawid:mawid_dev_only@localhost:54329/mawid
# Separate database used by the test suite (created automatically).
TEST_DATABASE_URL=postgres://mawid:mawid_dev_only@localhost:54329/mawid_test
# Server secrets: generate each with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
API_KEY_PEPPER=
SLOT_TOKEN_SECRET=
PORT=3000

# Local development only: allow webhook URLs that are http or point to this machine. Never set in production.
# WEBHOOKS_ALLOW_LOCAL=true

# Production behind https: mark the panel cookies Secure, and trust the reverse proxy for the client IP.
# COOKIE_SECURE=true
# TRUST_PROXY=true

# The address people reach the API at (shown in /docs), e.g. https://api.example.com
# PUBLIC_URL=
